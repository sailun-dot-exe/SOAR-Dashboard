# Copy to .env (scripts/e2e_test.py generates one with random secrets automatically).
SOAR_API_TOKEN=change-me-siem-shared-secret
SOAR_ADMIN_TOKEN=change-me-admin-token
SOAR_HITL_SIGNING_KEY=change-me-hitl-hmac-key
POSTGRES_PASSWORD=change-me-postgres
# Wazuh API password policy: 8-64 chars with upper, lower, digit and symbol.
WAZUH_API_PASSWORD=SoarLab.2026-Api
# Base URL embedded in Slack/e-mail approve/deny links (must be reachable by approvers).
SOAR_PUBLIC_BASE_URL=http://localhost:8000
# Optional: Slack incoming webhook for HITL notifications.
SOAR_SLACK_WEBHOOK_URL=
SOAR_HITL_TIMEOUT_SECONDS=300
